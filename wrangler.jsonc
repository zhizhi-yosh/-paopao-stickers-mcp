{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paopao-stickers-mcp",
  "main": "worker.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ]
}
